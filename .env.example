# Copier ce fichier en `.env` et remplir les valeurs. Ne jamais committer `.env`.

# --- Django ---
SECRET_KEY=change-moi-par-une-longue-valeur-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Base de données ---
# Laisser vide (ou commenté) pour utiliser SQLite en local.
# Sinon : adresse de la branche Neon `dev` (jamais celle de production en local).
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require

# --- IA ---
# `faux` par défaut : aucun appel réel, aucun coût. Passer à `openrouter`
# uniquement pour un essai manuel volontaire.
IA_FOURNISSEUR=faux
OPENROUTER_API_KEY=
IA_MODELE_GENERATION=openai/gpt-6-luna
IA_MODELE_INTERROGATOIRE=openai/gpt-6-luna
IA_DELAI_SECONDES=20
